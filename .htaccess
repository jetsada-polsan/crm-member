# http://localhost/popstar-business-platform-v4/ -> index.html -> opens the CRM (http://popstar.localhost)
# The folder is visible in the localhost index; only secrets and customer-data backups stay blocked.
Require all granted
Options -Indexes
DirectoryIndex index.html

# Passwords / tokens (.env, postgres password file, sync-agent config, backups of them), logs and archives
<FilesMatch "^(\.env.*|\.pgpass.*|config\.env.*|.*\.dump|.*\.bak.*|.*\.log|.*\.(zip|rar|7z|sql))$">
    Require all denied
</FilesMatch>

# Dot folders (.git, .claude), Docker data backups (customer data), sync-agent, tools, Laravel internals.
# Matches at any depth so the protection holds whatever this folder is named (crm-member, popstar-business-platform-v4, ...).
RedirectMatch 404 (?i)/(\.[^/]+|_docker_backup|_backups|sync-agent|tools|backend-overlay|backend/(?!public(/|$)))
