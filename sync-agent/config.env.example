SYNC_BASE_URL=http://127.0.0.1:18080
SYNC_API_TOKEN=REPLACE_WITH_RANDOM_64_HEX
BRIDGE_API_TOKEN=REPLACE_WITH_DIFFERENT_RANDOM_64_HEX
SYNC_SOURCE=BPLUS
BRIDGE_PORT=18900
# Copy this file to sync-agent/config.env and fill with READ-ONLY SQL account credentials (NEVER use sa):
# Preferred Windows setup: run configure_sql_connection.ps1. It prompts for the password with hidden input and stores it using current-user DPAPI.
# The bridge builds an encrypted SqlClient connection from SQL_SERVER/PORT/DATABASE/USER and SQL_PASSWORD_DPAPI.
# Do not commit config.env or put a real password in this example file.
# Manual SqlClient connection strings must keep certificate validation enabled:
# SQL_CONNECTION_STRING=Server=tcp:SERVER,1433;Database=DATABASE;User Id=READ_ONLY_USER;Password=...;Encrypt=True;TrustServerCertificate=False;ApplicationIntent=ReadOnly;Connection Timeout=15;
# Option B (Windows ODBC Driver {SQL Server}):
# SQL_CONNECTION_STRING=Driver={SQL Server};Server=192.168.88.200,1433;Database=BPLUSERP_POPSTAR_2021;Uid=jetsada;Pwd=YOUR_PASSWORD;
SQL_CONNECTION_STRING=
SQL_TRUST_SERVER_CERTIFICATE=false
