# POPSTAR CRM v4 — Standalone Python Web Monitor for Server 201 (Port 8770)
# Copy this file to server201.env on Server 201 (192.168.88.201) and fill in credentials.
# Completely separate from bplusAPI (port 8765).

POPSTAR_AGENT_HOST=0.0.0.0
POPSTAR_AGENT_PORT=8770
POPSTAR_WEB_PASSWORD=Popstar2026!
POPSTAR_AUTO_SYNC=false
POPSTAR_AUTO_SYNC_MINUTES=15

# Target POPSTAR CRM Server (Cloudflare HTTPS Push API - No VPN required)
SYNC_BASE_URL=https://crm.popstarmember.com
SYNC_API_TOKEN=PUT_YOUR_32_PLUS_CHAR_SYNC_API_TOKEN_HERE
SYNC_SOURCE=BPLUS

# Bplus SQL Server (Read-Only)
SQL_SERVER=192.168.88.200
SQL_PORT=1433
SQL_DATABASE=BPLUSERP_POPSTAR_2021
SQL_ODBC_DRIVER=ODBC Driver 17 for SQL Server
SQL_USER=jetsada
SQL_PASSWORD=PUT_READONLY_SQL_PASSWORD_HERE
